build/bin
node_modules
frontend/dist

# Real save files are test fixtures only. They contain other players'
# Steam IDs and character data — never commit them.
testdata/*.sav
testdata/*.gvas
testdata/Players/

# Oodle: oo2core is Epic-owned and must never be redistributed.
# ooz may be bundled only if its license permits (verify before adding).
third_party/oodle/oo2core*.dll

*.exe

# vendored ooz clone (fetch via docs/THIRD_PARTY.md), and its build output
third_party/oodle/ooz-zao/
third_party/oodle/ooz/
third_party/oodle/*.dll

# Pal and item artwork is Pocketpair's and is never committed. Fetch it onto
# your own machine with scripts/fetch-icons.sh; the editor runs fine without it.
assets/icons/
